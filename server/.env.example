# Copy to server/.env and fill in. Everything except the quiz works without a key.

# Required only for quizzes (transcription + question generation).
OPENAI_API_KEY=

# Model used to turn a transcript into multiple-choice questions.
OPENAI_QUIZ_MODEL=gpt-4o-mini

# Speech-to-text model used on the captured radio clip.
OPENAI_TRANSCRIBE_MODEL=whisper-1

# The language you are learning. Drives the Radio Browser query, the
# transcription language hint, and the quiz prompts.
TARGET_LANGUAGE=spanish

# HTTP port for the API server.
PORT=8787

# Where the SQLite database lives (relative paths resolve from server/).
DB_PATH=data/language-globe.sqlite

# Seconds of radio audio to capture for a quiz.
CAPTURE_SECONDS=60
