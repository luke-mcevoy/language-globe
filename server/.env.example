# Copy to server/.env and fill in. The globe, player, favorites, and stats
# work with no extra config. Captions need whisper.cpp; quizzes and word
# lookup need Ollama.

# Default learning language when the UI has not picked one. The picker
# can switch this per visitor (spanish, italian, french, …).
TARGET_LANGUAGE=spanish

# HTTP port for the API server.
PORT=8787

# HTTP bind host. Use 0.0.0.0 when testing the mobile app on a phone.
HOST=127.0.0.1

# Where the SQLite database lives (relative paths resolve from server/).
DB_PATH=data/language-globe.sqlite

# Seconds of radio audio to capture for a quiz.
CAPTURE_SECONDS=60

# whisper.cpp model used for transcription and word timing.
# Default: server/models/ggml-large-v3-turbo.bin
# WHISPER_MODEL_PATH=

# Point at an externally managed whisper-server instead of spawning one.
# Used by the Docker container to reach whisper running natively on the host
# (Metal GPU speed): WHISPER_SERVER_URL=http://host.docker.internal:8788
# Start one on the host with:
#   whisper-server -m server/models/ggml-large-v3-turbo.bin -l auto \
#     --port 8788 --host 127.0.0.1 --dtw large.v3.turbo --no-flash-attn
# WHISPER_SERVER_URL=

# Ollama for quiz generation and word translation.
# Install Ollama, then: ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
